# ==========================================
# DISCORD MUSIC & VOICE ANNOUNCER BOT CONFIG
# ==========================================

# Token của bot Discord (Lấy tại: https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Client ID / Application ID của bot
CLIENT_ID=your_client_id_here

# Discord ID của Admin tối cao (Dùng để nhận DM bảng điều khiển bí mật)
ADMIN_USER_ID=your_discord_user_id_here

# Ký tự/Mã bí mật kích hoạt bảng điều khiển Admin (Mặc định: #ad)
SECRET_CODE=#ad

# ID kênh âm nhạc mặc định (Để trống nếu muốn bot nhận diện ở mọi text channel)
MUSIC_CHANNEL_ID=

# Ngôn ngữ TTS Google (Mặc định: vi)
TTS_LANG=vi

# Thời gian Cooldown TTS tính theo giây (Mặc định: 10 giây)
TTS_COOLDOWN=10
